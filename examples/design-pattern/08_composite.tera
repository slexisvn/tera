interface FileSystemNode:
  size() -> int

class FileItem implements FileSystemNode:
  name: string
  sizeValue: int
  constructor(name: string, size: int):
    this.name = name
    this.sizeValue = size
  size() -> int:
    return this.sizeValue

class Folder implements FileSystemNode:
  name: string
  children: FileSystemNode[] = []
  constructor(name: string):
    this.name = name
    this.children = []
  add(child: FileSystemNode) -> Folder:
    this.children.push(child)
    return this
  size() -> int:
    total = 0
    for child of this.children:
      total += child.size()
    return total

root = Folder("root").add(FileItem("a.txt", 3)).add(Folder("src").add(FileItem("main.tera", 7)))

print("composite:", root.size())
