interface Participant:
  receive(sender: string, text: string) -> string

class ChatRoom:
  private users: User[] = []
  public constructor():
    this.users = []
  public join(user: User) -> void:
    this.users.push(user)
    user.setRoom(this)
  public send(sender: User, text: string) -> string:
    messages = []
    for user of this.users:
      if user.name != sender.name:
        messages.push(user.receive(sender.name, text))
    return messages.join(" | ")

class User implements Participant:
  public name: string
  private room: ChatRoom | null = null
  public constructor(name: string):
    this.name = name
  public setRoom(room: ChatRoom) -> void:
    this.room = room
  public say(text: string) -> string:
    room = this.room
    if room != null:
      return room.send(this, text)
    return "offline"
  public receive(sender: string, text: string) -> string:
    return this.name + "<-" + sender + ":" + text

room = ChatRoom()
alice = User("alice")
bob = User("bob")
room.join(alice)
room.join(bob)

print("mediator:", alice.say("hi"))
