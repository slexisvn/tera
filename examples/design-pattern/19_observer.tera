interface Observer:
  update(value: string) -> string

class Subject:
  private listeners: Observer[] = []
  public constructor():
    this.listeners = []
  public subscribe(listener: Observer) -> void:
    this.listeners.push(listener)
  public notify(value: string) -> string:
    out = []
    for listener of this.listeners:
      out.push(listener.update(value))
    return out.join(",")

class Listener implements Observer:
  private name: string
  public constructor(name: string):
    this.name = name
  public update(value: string) -> string:
    return this.name + ":" + value

subject = Subject()
subject.subscribe(Listener("a"))
subject.subscribe(Listener("b"))

print("observer:", subject.notify("ready"))
