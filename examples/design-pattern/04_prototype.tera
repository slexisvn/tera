interface CloneableDocument:
  title: string
  tags: string[]
  clone() -> CloneableDocument
  rename(title: string) -> CloneableDocument
  addTag(tag: string) -> CloneableDocument

class Document implements CloneableDocument:
  public title: string
  public tags: string[]
  public constructor(title: string, tags: string[]):
    this.title = title
    this.tags = tags
  public clone() -> CloneableDocument:
    return Document(this.title, this.tags.slice())
  public rename(title: string) -> CloneableDocument:
    this.title = title
    return this
  public addTag(tag: string) -> CloneableDocument:
    this.tags.push(tag)
    return this

base = Document("contract", ["legal"])
copy = base.clone().rename("contract-copy").addTag("draft")

print("prototype:", base.title, base.tags.join("/"), "|", copy.title, copy.tags.join("/"))
